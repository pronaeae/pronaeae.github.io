---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { title, description } = Astro.props.frontmatter;
---

<BaseLayout title={title} description={description}>
  <article class="page">
    <h1>{title}</h1>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    max-width: var(--prose);
    margin: calc(6 * var(--space)) auto 0;
  }

  .page h1 {
    margin: 0 0 calc(4 * var(--space));
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.2vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.012em;
  }
</style>
