---
import { site } from '../../site.config';

const { repo, repoId, category, categoryId } = site.giscus;

/**
 * giscus 앱을 아직 설치하지 않았으면 아무것도 그리지 않는다.
 * 설정이 빈 채로 스크립트를 띄우면 빈 회색 상자만 남는다.
 */
const configured = repo !== '' && repoId !== '' && categoryId !== '';
---

{configured && (
  <section class="comments">
    <script
      is:inline
      src="https://giscus.app/client.js"
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-mapping="pathname"
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-lang="ko"
      data-loading="lazy"
      crossorigin="anonymous"
      async
    ></script>
  </section>
)}

<style>
  .comments {
    margin-top: calc(6 * var(--space));
    padding-top: calc(4 * var(--space));
    border-top: 1px solid var(--border);
  }
</style>

<script>
  /*
   * giscus 는 자기 테마를 스스로 알 수 없으므로 로드 직후 한 번 맞춰준다.
   * 이후의 전환은 ThemeToggle 이 postMessage 로 알린다.
   */
  window.addEventListener('message', (event) => {
    if (event.origin !== 'https://giscus.app') return;
    if (typeof event.data !== 'object' || event.data === null) return;
    if (!('giscus' in event.data)) return;

    const frame = document.querySelector<HTMLIFrameElement>(
      'iframe.giscus-frame',
    );
    frame?.contentWindow?.postMessage(
      {
        giscus: {
          setConfig: { theme: document.documentElement.dataset.theme },
        },
      },
      'https://giscus.app',
    );
  });
</script>
