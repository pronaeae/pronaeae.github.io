---
import { Image } from 'astro:assets';
import { formatCategory, formatDate, toIsoDate } from '../lib/format';
import type { Post } from '../queries';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { data } = post.entry;
---

<a class="card" href={post.url}>
  <div class="text">
    <span class="category">{formatCategory(post.category)}</span>
    <h2 class="title">{data.title}</h2>
    <p class="summary">{data.description}</p>
    <time class="date" datetime={toIsoDate(data.date)}>
      {formatDate(data.date)}
    </time>
  </div>
  {data.thumbnail && (
    <div class="thumb">
      <Image src={data.thumbnail} alt="" width={352} loading="lazy" />
    </div>
  )}
</a>

<style>
  .card {
    display: flex;
    align-items: stretch;
    gap: calc(2 * var(--space));
    padding: calc(2 * var(--space)) calc(1.5 * var(--space));
    border-radius: 5px;
    transition: background-color 0.2s ease-in-out;
  }

  .card:hover {
    background: var(--hover);
  }

  .text {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .category {
    font-size: 0.857rem;
    line-height: 1.66;
    color: var(--text-sub);
  }

  .title {
    margin: 0 0 var(--space);
    font-family: var(--font-serif);
    font-size: clamp(1.42rem, 2vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.016em;
    line-height: 1.35;
  }

  .summary {
    margin: 0 0 calc(4 * var(--space));
    font-size: clamp(0.92rem, 1.2vw, 1rem);
    line-height: 1.6;
    color: var(--text-body);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .date {
    margin-top: auto;
    font-size: 0.92rem;
    letter-spacing: 0.01em;
    color: var(--text-sub);
  }

  /*
   * 썸네일 칸은 비율로 자리를 먼저 잡는다. 이미지가 늦게 와도 글이 밀리지 않는다.
   * 900px 미만에서는 텍스트 위로 올라가 가로 전체를 쓴다.
   */
  .thumb {
    position: relative;
    flex-shrink: 0;
    width: 100%;
    padding-bottom: 54%;
    order: -1;
    margin-bottom: calc(2 * var(--space));
  }

  .thumb :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
  }

  @media (max-width: 899px) {
    .card {
      flex-direction: column;
    }
  }

  @media (min-width: 900px) {
    .thumb {
      width: 176px;
      padding-bottom: 68%;
      order: 0;
      margin-bottom: 0;
      align-self: center;
    }
  }
</style>
